{
  "functions": {
    "api/profile.js": {
      "includeFiles": "build/index.html"
    }
  },
  "rewrites": [
    {
      "source": "/start",
      "destination": "/index.html"
    },
    {
      "source": "/og/@:username",
      "destination": "/api/og?username=:username"
    },
    {
      "source": "/@:username",
      "destination": "/api/profile?username=:username"
    }
  ]
}